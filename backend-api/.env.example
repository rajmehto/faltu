NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/tango_live
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=tango_live
PG_USER=postgres
PG_PASSWORD=your_password

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Firebase
FIREBASE_SERVICE_ACCOUNT_JSON={}
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Agora
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=+1234567890

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=noreply@tangolive.app

# App
APP_URL=https://tangolive.app
ALLOWED_ORIGINS=http://localhost:3000,https://tangolive.app

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=tango-live-media

# OpenAI (AI features)
OPENAI_API_KEY=your_openai_key

# Sentry
SENTRY_DSN=your_sentry_dsn
